# Этап 1: Установка зависимостей и обфускация
FROM python:3.12-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc python3-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Копируем requirements.txt и устанавливаем зависимости
COPY server/proxy/requirements.txt /app/server/proxy/requirements.txt
RUN pip install --no-cache-dir -r server/proxy/requirements.txt \
    && pip install pyarmor

COPY server/proxy /app/server/proxy
COPY database/database.py /app/database/database.py
COPY server/classifier /app/server/classifier
COPY server/gigachat /app/server/gigachat

# Проверяем файлы и обфусцируем весь пакет
RUN pyarmor gen --recursive --output /app/dist-proxy /app/server/proxy \
    && pyarmor gen --output /app/dist-db /app/database/database.py \
    && pyarmor gen --recursive --output /app/dist-classifier /app/server/classifier \
    && pyarmor gen --recursive --output /app/dist-gigachat /app/server/gigachat
# Копируем runtime-модуль PyArmor в site-packages
RUN cp -r /app/dist-proxy/pyarmor_runtime_000000 /usr/local/lib/python3.12/site-packages/ \
    && rm -rf /app/dist-proxy/pyarmor_runtime_000000  # Удаляем, чтобы не дублировать

# Этап 2: Финальный минимальный образ
FROM python:3.12-slim

WORKDIR /app

# Создаём пользователя без root-привилегий
RUN useradd -m appuser
USER appuser

# Копируем зависимости
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Копируем обфусцированный код
COPY --from=builder /app/dist-proxy /app/server
COPY --from=builder /app/dist-classifier /app/server
COPY --from=builder /app/dist-db /app/database
COPY --from=builder /app/dist-gigachat /app/server
COPY server/classifier/classifier_egida/checkpoint-9852  /app/server/classifier/classifier_egida/checkpoint-9852
COPY server/classifier/classifier_tarantino/tarantino-classifier-balanced  /app/server/classifier/classifier_tarantino/tarantino-classifier-balanced 
COPY server/classifier/classifier_tarantino/input_classifier_prompt.txt  /app/server/classifier/classifier_tarantino/input_classifier_prompt.txt
# Устанавливаем PYTHONPATH
ENV PYTHONPATH=/app

EXPOSE 8080

CMD ["python", "server/proxy/app.py"]